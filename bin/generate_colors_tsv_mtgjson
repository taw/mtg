#!/usr/bin/env ruby

require "json"
require "set"

class Card
  attr_reader :generated_colors, :used_colors
  def initialize(data)
    @data = data
    @generated_colors = Set[]
    @used_colors = Set[]
    parse_manacost!
    parse_text!
    parse_type!
  end

  # Name of this face, "Fire" for "Fire // Ice"
  def name
    @name ||= cleanup_name(@data["faceName"] || @data["name"])
  end

  # Names of all faces of the card this face belongs to
  def names
    @names ||= begin
      parts = (@data["name"] || "").split(" // ").map{|n| cleanup_name(n)}.uniq
      parts.empty? ? [name] : parts
    end
  end

  def manacost
    @manacost ||= (@data["manaCost"] || "").downcase
  end

  def type
    @type ||= @data["type"] || ""
  end

  def text
    @text ||= @data["text"] || ""
  end

  def cleanup_name(name)
    name = name.dup
    name.gsub!("’", "'")
    name.gsub!("Æ", "Ae")
    name.gsub!(/\AAether/i, "Aether")
    name.gsub!(%r[\s*(/+|&)\s*], " // ")
    name
  end

  def add_gen!(gen)
    @generated_colors.merge symbol_colors(gen)
  end

  def add_cost!(cost)
    @used_colors.merge symbol_colors(cost)
  end

  # Symbols come in a lot of shapes: {G}, {2/G}, {G/P}, {G/W/P}, {HG} (half mana),
  # as well as plenty of colorless ones like {X}, {T}, {S}, {E}, {TK}, {∞}
  # Returns every color mentioned by the symbol, possibly none
  def symbol_colors(symbol)
    parts = symbol.downcase.split("/")
    colors = parts.map{|part| part.sub(/\Ah/, "")}.grep(/\A[wubrgc]\z/)
    if colors.empty? and parts.none?{|part| part =~ COLORLESS_SYMBOL}
      warn_unknown_symbol! symbol
    end
    colors
  end

  COLORLESS_SYMBOL = /\A(\d+|x|y|z|s|p|t|q|e|a|d|l|c|h|hw|hr|chaos|tk|½|∞)\z/

  def warn_unknown_symbol!(symbol)
    @@unknown_symbols ||= Set[]
    return unless @@unknown_symbols.add?(symbol)
    warn "Unrecognized mana symbol {#{symbol}} (#{@data["name"]})"
  end

  def parse_manacost!
    manacost.scan(/\{(.*?)\}/).flatten.each do |cost|
      add_cost! cost
    end
  end

  def parse_cost!(costs)
    costs.scan(/\{(.*?)\}/).flatten.each do |cost|
      add_cost! cost
    end
  end

  def parse_effect!(effect)
    effect.scan(/\{(.*?)\}/).flatten.each do |gen|
      add_gen! gen
    end
    # "Add one mana of any color", "Add three mana of any one color",
    # "Add one mana of any type that land produced", ...
    @generated_colors.merge ["w", "u", "b", "r", "g"] if effect =~ /\bany\b[^.]{0,30}\b(colors?|types?)\b/
  end

  def parse_text!
    text.split("\n").each{|line|
      line = line.downcase
      # Reminder text repeats mana symbols which aren't really part of the card
      # ("...if the card's mana cost is {3}{U}{U}{B}, you add {U}{U}{B}.")
      line.gsub!(/\(.*?\)/, "")
      line.gsub!(/\{(\d+|x|t)\}/){ $1 }
      @used_colors << "w" << "b" if line =~ /\bextort\b/
      next unless line =~ /\{|mana/
      # Mana abilities, both modern ("Add {G}{G}.") and pre-2018 wording
      # ("Add {G}{G} to your mana pool."), one clause at a time
      # This is sort of dubious
      while line.sub!(/\badds?\b([^.]*)/, "")
        parse_effect! $1
      end
      parse_cost! line
    }
  end

  def parse_type!
    @generated_colors << "w" if type =~ /\bPlains\b/i
    @generated_colors << "u" if type =~ /\bIsland\b/i
    @generated_colors << "b" if type =~ /\bSwamp\b/i
    @generated_colors << "r" if type =~ /\bMountain\b/i
    @generated_colors << "g" if type =~ /\bForest\b/i
  end
end

class CardDatabase
  def initialize(path)
    @path = path
    @cards = Set[]
    @parts = {}
  end

  def import!
    data = JSON.parse(File.read(@path))
    # MTGJSON v5 wraps the sets in "data", older versions are just a set map
    sets = data["data"] || data
    sets.each do |set_code, set|
      (set["cards"] || []).each do |card|
        add_card! card
      end
    end
  end

  def add_card!(card_data)
    part = Card.new(card_data)
    @cards << part.names
    @parts[part.name] = part
  end

  def format_mana(mana)
    order = {"w"=>0, "u"=>1, "b"=>2, "r"=>3, "g"=>4, "c"=>5}
    mana.sort_by{|c| order.fetch(c) }.join
  end

  def each_part
    @parts.values.each do |card|
      yield(card.name, format_mana(card.generated_colors), format_mana(card.used_colors))
    end
  end

  def each_card
    @cards.each do |parts|
      # Faces we never saw as their own entry (some meld backs) contribute nothing
      known = parts.map{|c| @parts[c]}.compact
      next if known.empty?
      gen = known.map(&:generated_colors).inject(&:|)
      used = known.map(&:used_colors).inject(&:|)
      parts.each do |p|
        yield(p, gen, used)
      end
      if parts.size == 2
        yield parts.join(" // "), gen, used
        yield parts.reverse.join(" // "), gen, used
      end
      if parts.size > 2
        yield parts.join(" // "), gen, used
      end
    end
  end

  def print!
    # Different cards can share a name ("Fire" of "Fire // Ice" and the
    # playtest card), so merge them into one line instead of emitting both
    merged = {}
    enum_for(:each_card).each do |name, gen, use|
      gen_so_far, use_so_far = merged[name] || [Set[], Set[]]
      merged[name] = [gen_so_far | gen, use_so_far | use]
    end
    merged.sort.each do |name, (gen, use)|
      puts [name, format_mana(gen), format_mana(use)].join("\t")
    end
  end

  def call
    import!
    print!
  end
end

CardDatabase.new(ARGV[0] || "AllSets.json").call
