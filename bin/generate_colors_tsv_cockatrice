#!/usr/bin/env ruby

require "nokogiri"

class Card
  def initialize(c)
    @name = c.at_xpath("name")&.text
    # Card database v4 moved these into <prop>, v3 had them on <card>
    @manacost = (c.at_xpath("prop/manacost") || c.at_xpath("manacost"))&.text || ""
    @type = (c.at_xpath("prop/type") || c.at_xpath("type"))&.text || ""
    @text = c.at_xpath("text")&.text || ""
    @generated_colors = []
    @used_colors = []
    parse_manacost!
    parse_text!
    parse_type!
    simplify_colors!
  end

  def data
    [@name, @generated_colors, @used_colors]
  end

  def simplify_colors!
    key = {"w" => 0, "u" => 1, "b" => 2, "r" => 3, "g" => 4}
    @generated_colors = @generated_colors.join.gsub(/[^wubrg]/, "").split(//).uniq.sort_by{|c| key[c]}.join
    @used_colors = @used_colors.join.gsub(/[^wubrg]/, "").split(//).uniq.sort.sort_by{|c| key[c]}.join
  end

  def parse_manacost!
    # v4 costs are bare symbol soup - "3G", "1U/B", "4R/WR/W", "2WW // X2W"
    # (v3 wrote hybrids as "(2/W)"), so just pick the colors out of it
    @used_colors += @manacost.downcase.scan(/[wubrg]/)
    warn "WTF mana: #{@manacost}" if @manacost =~ %r[[^0-9wubrgcsxyzph½∞/() ]]i
  end

  def parse_cost!(cost)
    warn "WTF COST? #{cost}" if cost =~ /mana pool/ and cost =~ /\{/
    @used_colors += cost.scan(/\{(.*?)\}/).flatten.map(&:downcase)
  end

  def parse_effect!(effect)
    @generated_colors += effect.scan(/\{(.*?)\}/).flatten.map(&:downcase)
    # "Add one mana of any color", "Add three mana of any one color",
    # "Add one mana of any type that land produced", ...
    @generated_colors << "wubrg" if effect =~ /\bany\b[^.]{0,30}\b(colors?|types?)\b/i
  end

  def parse_text!
    @text.split("\n").each{|line|
      line = line.dup
      # Reminder text repeats mana symbols which aren't really part of the card
      # ("...if the card's mana cost is {3}{U}{U}{B}, you add {U}{U}{B}.")
      line.gsub!(/\(.*?\)/, "")
      line.gsub!(/\{(\d+|X|T)\}/){ $1 }
      @used_colors << "(w/b)" if line =~ /\bExtort\b/i
      next unless line =~ /\{|mana/
      # Mana abilities, both modern ("Add {G}{G}.") and pre-2018 wording
      # ("Add {G}{G} to your mana pool."), one clause at a time
      # This is sort of dubious
      while line.sub!(/\bAdds?\b([^.]*)/i, "")
        parse_effect! $1
      end
      parse_cost! line
    }
  end

  def parse_type!
    @generated_colors << "w" if @type =~ /\bPlains\b/i
    @generated_colors << "u" if @type =~ /\bIsland\b/i
    @generated_colors << "b" if @type =~ /\bSwamp\b/i
    @generated_colors << "r" if @type =~ /\bMountain\b/i
    @generated_colors << "g" if @type =~ /\bForest\b/i
  end

end

cards = []
# Streaming parse - cards.xml is far too big to load into memory as a DOM
reader = Nokogiri::XML::Reader(File.open(ARGV[0] || "cards.xml"))
reader.each do |node|
  next unless node.name == "card" and node.node_type == Nokogiri::XML::Reader::TYPE_ELEMENT
  card = Card.new(Nokogiri::XML(node.outer_xml).root)
  cards << card.data
end
puts cards.sort.map{|name, gen, use|
  [name, gen, use].join("\t")
}.uniq
